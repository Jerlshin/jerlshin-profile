---
/**
 * Aside — a margin note: a tangent, a caveat, a pointer to further reading.
 *
 * Distinct from Callout by weight, not by markup. A Callout stops the reader
 * and demands attention; an Aside is optional context they may skip. Giving
 * them the same visual weight teaches readers to ignore both.
 *
 * At ≥1440px it moves into the right rail (--rail-w) beside the paragraph it
 * belongs to. Below that it stays in flow, because a 68ch measure plus a
 * side rail does not fit and pretending otherwise produces a 20ch column.
 */
interface Props {
  /** Optional short label, e.g. "Further reading". */
  label?: string;
  /** Force in-flow rendering even on a wide viewport. */
  inline?: boolean;
  class?: string;
}

const { label, inline = false, class: className } = Astro.props;
---

<aside class:list={['aside', { inline }, className]} role="note">
  {label && <p class="overline label">{label}</p>}
  <div class="body">
    <slot />
  </div>
</aside>

<style>
  .aside {
    margin-block: 1.5em;
    padding-inline-start: 1rem;
    border-inline-start: 2px solid var(--line-strong);
    color: var(--ink-2);
    font-size: var(--fs-sm);
    line-height: var(--lh-normal);
  }

  .label {
    margin-block-end: 0.375rem;
  }

  .body :global(> :first-child) {
    margin-block-start: 0;
  }

  .body :global(> :last-child) {
    margin-block-end: 0;
  }

  /*
   * The rail only exists where there is genuinely surplus width. `float` is
   * used deliberately over absolute positioning: a floated note cannot overlap
   * a following heading, and it reflows with the paragraph it was written
   * beside instead of being pinned to a scroll offset.
   */
  @media (min-width: 90rem) {
    .aside:not(.inline) {
      float: inline-end;
      inline-size: var(--rail-w);
      margin-inline-end: calc(-1 * (var(--rail-w) + 2rem));
      margin-block-start: 0.35em;
      clear: inline-end;
    }
  }
</style>
