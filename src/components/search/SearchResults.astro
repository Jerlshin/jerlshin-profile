---
/**
 * SearchResults — the region mountSearch() fills: facet chips, a status line,
 * and the list of hits.
 *
 * IT IS EMPTY IN THE HTML, AND THAT IS CORRECT. Everything here is a container;
 * Pagefind's index is a build artifact fetched at query time, so there is
 * nothing a server could have put inside these elements. That makes this the
 * one part of the site with no no-JavaScript equivalent — which is why /search
 * renders a real list of every archive alongside it, and why the ⌘K trigger is
 * hidden until its own script runs (the ThemeToggle discipline: a control that
 * cannot work is a control that is not shown).
 *
 * ELEMENTS ARE FOUND BY DATA ATTRIBUTE, NOT BY ID. /search carries both its own
 * panel and the sitewide ⌘K dialog, so ids would collide and one of the two
 * panels would silently drive the other's DOM.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['results-region', className]} data-pagefind-ignore>
  {
    /* `hidden` until there is more than one kind to filter by. A facet row with
      a single chip is a control that cannot change anything. */
  }
  <div class="facets" data-search-facets hidden role="group" aria-label="Filter results by kind">
  </div>

  {
    /* role="status" announces the count to a screen reader without stealing
      focus, so typing is never interrupted by the results updating. */
  }
  <p class="status" data-search-status role="status" aria-live="polite"></p>

  <ol class="results" data-search-results></ol>
</div>

<style>
  .results-region {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    min-inline-size: 0;
  }

  .facets {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .facets[hidden] {
    display: none;
  }

  /* `:global` because these chips are created by src/lib/search-ui.ts, so they
     never carry this component's scoping attribute. Kept inside .facets so the
     selector is still bounded by markup this component owns. */
  .facets :global(.facet) {
    min-block-size: 2rem;
    padding: 0.25rem 0.625rem;
    background-color: var(--surface);
    border: 1px solid var(--control);
    border-radius: var(--radius-full);
    color: var(--ink-2);
    font-family: var(--ff-mono);
    font-size: var(--fs-xs);
    cursor: pointer;
    transition:
      color var(--dur-fast) var(--ease),
      background-color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease);
  }

  .facets :global(.facet:hover) {
    color: var(--ink);
    border-color: var(--ink-3);
  }

  .facets :global(.facet[aria-pressed='true']) {
    background-color: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }

  .status {
    color: var(--ink-3);
    font-family: var(--ff-mono);
    font-size: var(--fs-xs);
  }

  /* Collapses the gap entirely while the status line is empty — its resting
     state — instead of reserving a blank row above the results. */
  .status:empty {
    display: none;
  }

  .results {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .results :global(.result-link) {
    display: block;
    padding: 0.75rem 0.875rem;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    color: inherit;
    text-decoration: none;
    transition:
      background-color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease);
  }

  .results :global(.result-link:hover),
  .results :global(.result-link:focus-visible) {
    background-color: var(--surface-2);
    border-color: var(--line);
  }

  .results :global(.result-kind) {
    display: block;
    margin-block-end: 0.25rem;
    color: var(--accent);
    font-family: var(--ff-mono);
    font-size: var(--fs-2xs);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }

  .results :global(.result-title) {
    display: block;
    color: var(--ink);
    font-family: var(--ff-display);
    font-size: var(--fs-md);
    font-weight: 600;
    line-height: 1.3;
    text-wrap: balance;
  }

  .results :global(.result-excerpt) {
    margin-block-start: 0.3125rem;
    color: var(--ink-2);
    font-size: var(--fs-sm);
    line-height: 1.5;
  }

  /* Pagefind wraps every matched term in <mark>. Styled as weight and colour
     rather than the UA's yellow highlight, which does not survive either
     theme's background. */
  .results :global(.result-excerpt mark) {
    background: none;
    color: var(--ink);
    font-weight: 600;
  }
</style>
