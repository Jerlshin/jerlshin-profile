---
/**
 * SearchDialog — the ⌘K palette, present on every page via BaseLayout.
 *
 * THE SCRIPT IN THIS FILE IS THE ONLY PART OF SEARCH THAT LOADS EAGERLY, and it
 * does four things: reveal the trigger, print the platform's modifier key, open
 * the dialog, and `import()` the real search client the first time the dialog
 * opens. Everything expensive — src/lib/search-ui.ts, Pagefind's WebAssembly,
 * and the index chunks — is behind that dynamic import, so a visitor who never
 * searches never downloads any of it. That is what keeps §2.8's under-5-KB
 * budget honest with a search feature on the page (§6.1: "lazy").
 *
 * A native <dialog> + showModal(), for the same reasons as MobileDrawer: a real
 * focus trap, Escape to close, focus restored to the trigger, the rest of the
 * page inert, and a ::backdrop with no extra element.
 */
import Icon from '../primitives/Icon.astro';
import SearchResults from './SearchResults.astro';
---

<dialog id="search-dialog" class="dialog" aria-label="Search this site" data-pagefind-ignore>
  <div class="panel" data-search-panel>
    <div class="field">
      <Icon name="search" size="1.125rem" class="field-icon" />

      {
        /* type="search" gives the UA's clear button and the right virtual
          keyboard. `enterkeyhint` labels the touch keyboard's action key.
          No <form>: there is nothing to submit — results are live. */
      }
      <input
        type="search"
        class="input"
        data-search-input
        placeholder="Search papers, projects, and posts…"
        aria-label="Search query"
        autocomplete="off"
        autocorrect="off"
        spellcheck="false"
        enterkeyhint="search"
      />

      <button type="button" class="close" data-search-close aria-label="Close search">
        <Icon name="x" size="1.125rem" />
      </button>
    </div>

    <div class="scroll">
      <SearchResults />
    </div>

    <p class="foot">
      <a href="/search">Open the full search page</a>
    </p>
  </div>
</dialog>

<script>
  import type { SearchPanel } from '../../lib/search-ui.ts';

  const dialog = document.getElementById('search-dialog') as HTMLDialogElement | null;
  const panel = dialog?.querySelector<HTMLElement>('[data-search-panel]');
  const trigger = document.querySelector<HTMLElement>('[data-search-open]');

  if (dialog && panel) {
    // The control exists only now that something can service it.
    trigger?.removeAttribute('hidden');

    // Apple keyboards use ⌘; everything else uses Ctrl. The server cannot know
    // which, so the hint is written here rather than guessed at build time.
    // `navigator.userAgent` rather than `navigator.platform`, which is
    // deprecated and which `astro check` flags.
    const apple = /Mac|iPhone|iPad|iPod/.test(navigator.userAgent);
    const kbd = document.querySelector<HTMLElement>('[data-search-kbd]');
    if (kbd) kbd.textContent = apple ? '⌘K' : 'Ctrl K';

    /**
     * Mounted on first open, never on load. `mounted` is the promise rather
     * than a boolean so that two fast opens share one import instead of racing
     * two of them.
     */
    let mounted: Promise<SearchPanel> | undefined;

    const lockScroll = () => {
      document.documentElement.style.overflow = 'hidden';
    };

    const unlockScroll = () => {
      document.documentElement.style.overflow = '';
    };

    const open = () => {
      if (dialog.open) return;
      lockScroll();
      dialog.showModal();
      mounted ??= import('../../lib/search-ui.ts').then((m) => m.mountSearch(panel));
      void mounted.then((s) => s.focus());
    };

    trigger?.addEventListener('click', open);
    dialog.querySelector('[data-search-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('close', unlockScroll);

    // A click landing on the <dialog> itself rather than the panel is the
    // backdrop.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key.toLowerCase() === 'k' && (event.metaKey || event.ctrlKey)) {
        // Firefox and Chrome both bind ⌘K/Ctrl+K to the address bar.
        event.preventDefault();
        open();
      }
    });
  }
</script>

<style>
  .dialog {
    /* Reset the UA's centred box, then pin the panel near the top of the
       viewport — the palette convention, and it keeps the results list in the
       same place regardless of how many there are. */
    margin: 0 auto;
    padding: 0;
    border: 0;
    inline-size: min(40rem, calc(100vw - 2rem));
    max-inline-size: none;
    max-block-size: none;
    margin-block-start: min(12vh, 6rem);
    background: transparent;
    color: var(--ink);
  }

  @media (max-width: 40rem) {
    .dialog {
      margin-block-start: 0.5rem;
      inline-size: calc(100vw - 1rem);
    }
  }

  .dialog::backdrop {
    /* A literal, for the same reason as MobileDrawer's: ::backdrop sits in the
       top layer and does not reliably inherit custom properties across engines.
       Neutral translucent black reads correctly over both themes. */
    background-color: rgb(0 0 0 / 0.5);
  }

  .panel {
    display: flex;
    flex-direction: column;
    max-block-size: min(70vh, 40rem);
    background-color: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-2);
    overflow: hidden;
  }

  @media (max-width: 40rem) {
    .panel {
      max-block-size: calc(100dvh - 1rem);
    }
  }

  .field {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.625rem 0.75rem;
    border-block-end: 1px solid var(--line);
  }

  .field-icon {
    flex: none;
    color: var(--ink-3);
  }

  .input {
    flex: 1;
    min-inline-size: 0;
    padding: 0.375rem 0;
    background: transparent;
    border: 0;
    color: var(--ink);
    font-family: inherit;
    font-size: var(--fs-md);
  }

  .input:focus {
    /* The dialog itself is the focus indicator here: it opens with the caret
       already in this field, so a ring around the only input is noise. */
    outline: none;
  }

  .input::placeholder {
    color: var(--ink-3);
  }

  .close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    inline-size: var(--tap);
    block-size: var(--tap);
    padding: 0;
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    color: var(--ink-2);
    cursor: pointer;
  }

  .close:hover {
    color: var(--ink);
    background-color: var(--surface-2);
  }

  .scroll {
    /* The results scroll inside the panel; the page behind never moves. */
    flex: 1;
    min-block-size: 0;
    overflow-y: auto;
    padding: 0.75rem;
  }

  .foot {
    padding: 0.75rem 0.875rem;
    border-block-start: 1px solid var(--line);
    background-color: var(--surface-2);
    color: var(--ink-3);
    font-family: var(--ff-mono);
    font-size: var(--fs-xs);
  }

  .foot a {
    display: inline-block;
    color: var(--ink-2);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .foot a:hover {
    color: var(--ink);
  }
</style>
