---
/**
 * ExperienceItem — one role on the timeline.
 *
 * `end: null` renders as "Present" through lib/dates.ts (§4.5's convention:
 * null means ongoing, not missing). Nothing in this component re-implements
 * that check.
 *
 * Encapsulated in a distinct card structure with generous vertical rhythm,
 * refined typographic hierarchy, custom bullet indicators, and organized stack chips.
 */
import type { CollectionEntry } from 'astro:content';
import Card from '../primitives/Card.astro';
import Pill from '../primitives/Pill.astro';
import Icon from '../primitives/Icon.astro';
import StackList from './StackList.astro';
import { formatRange, isoDate } from '../../lib/dates.ts';

type Role = CollectionEntry<'experience'>;

interface Props {
  role: Role;
  level?: 2 | 3 | 4;
  isLast?: boolean;
  class?: string;
}

const KIND: Record<Role['data']['kind'], string> = {
  research: 'Research',
  industry: 'Industry',
  internship: 'Internship',
  teaching: 'Teaching',
  fellowship: 'Fellowship',
};

const { role, level = 3, isLast = false, class: className } = Astro.props;
const { data } = role;
const Heading = `h${level}` as const;

// Format location and mode without redundant repetition
const formatMode = (mode?: string) => (mode ? mode.charAt(0).toUpperCase() + mode.slice(1) : '');
const modeFormatted = formatMode(data.mode);
const showMode = data.mode && !data.location.toLowerCase().includes(data.mode.toLowerCase());
---

<div class:list={['timeline-node', { 'is-last': isLast }, className]}>
  <div class="rail" aria-hidden="true">
    <span class="marker"></span>
  </div>

  <Card as="article" padding="lg" class="role-card">
    <header class="role-header">
      <div class="title-group">
        <Heading class="role-title">{data.role}</Heading>
        <p class="org-line">
          {
            data.orgUrl ? (
              <a href={data.orgUrl} class="org-link" target="_blank" rel="noopener noreferrer">
                {data.organization}
                <span class="sr-only">(opens in a new tab)</span>
              </a>
            ) : (
              <span class="org-name">{data.organization}</span>
            )
          }
          <span class="location-tag">
            <Icon name="map-pin" size="0.8125rem" class="pin-icon" />
            <span>{data.location}{showMode ? ` · ${modeFormatted}` : ''}</span>
          </span>
        </p>
      </div>

      <div class="meta-badges">
        <time datetime={isoDate(data.start)} class="period-badge tabular">
          {formatRange(data.start, data.end)}
        </time>
        <Pill tone="neutral" size="sm">{KIND[data.kind]}</Pill>
      </div>
    </header>

    {data.summary && <p class="role-summary">{data.summary}</p>}

    {
      data.highlights && data.highlights.length > 0 && (
        <div class="highlights-block">
          <p class="section-label overline">Key Contributions</p>
          <ul class="highlights" aria-label={`Key achievements at ${data.organization}`}>
            {data.highlights.map((h) => (
              <li class="highlight-item">
                <span class="bullet" aria-hidden="true" />
                <span class="highlight-text">{h}</span>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    {
      data.stack && data.stack.length > 0 && (
        <div class="stack-section">
          <p class="section-label overline">Technologies & Tools</p>
          <StackList items={data.stack} class="stack-list" label={`${data.organization} technologies`} />
        </div>
      )
    }
  </Card>
</div>

<style>
  .timeline-node {
    position: relative;
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 1.5rem;
    align-items: stretch;
  }

  @media (max-width: 40rem) {
    .timeline-node {
      grid-template-columns: 1.25rem 1fr;
      gap: 0.75rem;
    }
  }

  .rail {
    position: relative;
    display: flex;
    justify-content: center;
    block-size: 100%;
    padding-block-start: 1.75rem;
  }

  /* Connecting vertical line */
  .rail::before {
    content: '';
    position: absolute;
    inset-block-start: 2rem;
    inset-block-end: -2rem;
    inset-inline-start: 50%;
    inline-size: 2px;
    transform: translateX(-50%);
    background-color: var(--line);
  }

  .timeline-node.is-last .rail::before {
    display: none;
  }

  .marker {
    position: relative;
    z-index: 1;
    inline-size: 0.875rem;
    block-size: 0.875rem;
    border-radius: 50%;
    border: 2px solid var(--accent);
    background-color: var(--surface);
    box-shadow: 0 0 0 3px var(--bg);
    transition:
      transform var(--dur-fast) var(--ease),
      background-color var(--dur-fast) var(--ease);
  }

  .timeline-node:hover .marker {
    background-color: var(--accent);
    transform: scale(1.15);
  }

  .role-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    background-color: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-1);
    transition:
      border-color var(--dur-fast) var(--ease),
      box-shadow var(--dur-fast) var(--ease);
  }

  .role-card:hover {
    border-color: var(--line-strong);
    box-shadow: var(--shadow-2);
  }

  .role-header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem 1.25rem;
    padding-block-end: 0.875rem;
    border-block-end: 1px solid var(--line);
  }

  .title-group {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    flex: 1;
    min-inline-size: min(100%, 16rem);
  }

  .role-title {
    margin: 0;
    color: var(--ink);
    font-family: var(--ff-display);
    font-size: var(--fs-xl);
    font-weight: 600;
    line-height: var(--lh-snug);
    text-wrap: balance;
  }

  .org-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem 0.75rem;
    margin: 0;
    font-size: var(--fs-sm);
  }

  .org-link {
    color: var(--accent);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.15em;
    text-decoration-thickness: from-font;
    transition: color var(--dur-fast) var(--ease);
  }

  .org-link:hover {
    color: var(--accent-hover);
  }

  .org-name {
    color: var(--ink);
    font-weight: 600;
  }

  .location-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--ink-3);
    font-size: var(--fs-xs);
  }

  .pin-icon {
    color: var(--ink-3);
  }

  .meta-badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .period-badge {
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-sm);
    background-color: var(--surface-2);
    border: 1px solid var(--line);
    color: var(--ink-2);
    font-family: var(--ff-mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--tracking-wide);
    white-space: nowrap;
  }

  .role-summary {
    margin: 0;
    color: var(--ink);
    font-size: var(--fs-base);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .highlights-block {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-block-start: 0.25rem;
  }

  .section-label {
    color: var(--ink-3);
    font-size: var(--fs-2xs);
    letter-spacing: var(--tracking-caps);
  }

  .highlights {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .highlight-item {
    display: grid;
    grid-template-columns: 0.5rem 1fr;
    gap: 0.75rem;
    align-items: baseline;
  }

  .bullet {
    display: inline-block;
    inline-size: 0.375rem;
    block-size: 0.375rem;
    border-radius: 50%;
    background-color: var(--accent);
    transform: translateY(-0.15em);
  }

  .highlight-text {
    margin: 0;
    color: var(--ink-2);
    font-size: var(--fs-sm);
    line-height: 1.65;
    text-wrap: pretty;
  }

  .stack-section {
    margin-block-start: 0.25rem;
    padding-block-start: 0.875rem;
    border-block-start: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .stack-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
</style>
