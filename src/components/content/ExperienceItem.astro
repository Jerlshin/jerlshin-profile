---
/**
 * ExperienceItem — one role on the timeline.
 *
 * `end: null` renders as "Present" through lib/dates.ts (§4.5's convention:
 * null means ongoing, not missing). Nothing in this component re-implements
 * that check.
 *
 * The organisation name is a link only when `orgUrl` exists. A styled span that
 * looks like a link but is not is the v1 site's dead-ExternalLink defect in
 * another shape.
 */
import type { CollectionEntry } from 'astro:content';
import Pill from '../primitives/Pill.astro';
import Icon from '../primitives/Icon.astro';
import StackList from './StackList.astro';
import { formatRange, isoDate } from '../../lib/dates.ts';

type Role = CollectionEntry<'experience'>;

interface Props {
  role: Role;
  level?: 2 | 3 | 4;
  class?: string;
}

const KIND: Record<Role['data']['kind'], string> = {
  research: 'Research',
  industry: 'Industry',
  internship: 'Internship',
  teaching: 'Teaching',
  fellowship: 'Fellowship',
};

const { role, level = 3, class: className } = Astro.props;
const { data } = role;
const Heading = `h${level}` as const;
---

<article class:list={['item', className]}>
  {
    /* The marker is the timeline's node. aria-hidden because the visual line
      conveys sequence that the DOM order already conveys. */
  }
  <span class="marker" aria-hidden="true"></span>

  <div class="head">
    <p class="period tabular">
      <time datetime={isoDate(data.start)}>{formatRange(data.start, data.end)}</time>
    </p>
    <Pill tone="neutral" size="sm">{KIND[data.kind]}</Pill>
  </div>

  <Heading class="role">{data.role}</Heading>

  <p class="org">
    {
      data.orgUrl ? (
        <a href={data.orgUrl} class="link" target="_blank" rel="noopener noreferrer">
          {data.organization}
          <span class="sr-only">(opens in a new tab)</span>
        </a>
      ) : (
        data.organization
      )
    }
    <span class="where">
      <Icon name="map-pin" size="0.8125rem" />
      {data.location}{data.mode && ` · ${data.mode}`}
    </span>
  </p>

  <p class="summary">{data.summary}</p>

  <ul class="highlights">
    {data.highlights.map((h) => <li>{h}</li>)}
  </ul>

  <StackList items={data.stack} class="stack" label={`${data.organization} technologies`} />
</article>

<style>
  .item {
    position: relative;
    padding-inline-start: 1.75rem;
    padding-block-end: var(--space-block);
  }

  /* The connecting line is drawn by the item, not by the list, so the last
     item can stop it cleanly instead of trailing into empty space. */
  .item::before {
    content: '';
    position: absolute;
    inset-block: 0.45rem 0;
    inset-inline-start: 0.3125rem;
    inline-size: 1px;
    background-color: var(--line);
  }

  .item:last-child {
    padding-block-end: 0;
  }

  .item:last-child::before {
    inset-block-end: auto;
    block-size: calc(100% - 0.45rem);
  }

  .marker {
    position: absolute;
    inset-block-start: 0.35rem;
    inset-inline-start: 0;
    inline-size: 0.6875rem;
    block-size: 0.6875rem;
    border-radius: 50%;
    border: 2px solid var(--accent);
    background-color: var(--bg);
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
  }

  .period {
    color: var(--ink-3);
    font-family: var(--ff-mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--tracking-wide);
  }

  .role {
    margin-block-start: 0.375rem;
    font-size: var(--fs-lg);
    line-height: var(--lh-snug);
  }

  .org {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    margin-block-start: 0.125rem;
    color: var(--ink-2);
    font-size: var(--fs-sm);
    font-weight: 500;
  }

  .where {
    display: inline-flex;
    align-items: center;
    gap: 0.3125rem;
    color: var(--ink-3);
    font-weight: 400;
  }

  .summary {
    margin-block-start: 0.75rem;
    max-inline-size: var(--measure);
    color: var(--ink-2);
    line-height: var(--lh-normal);
  }

  .highlights {
    margin-block-start: 0.75rem;
    padding-inline-start: 1.1rem;
    max-inline-size: var(--measure);
    list-style: disc;
    color: var(--ink-2);
    font-size: var(--fs-sm);
    line-height: var(--lh-normal);
  }

  .highlights li::marker {
    color: var(--ink-3);
  }

  .highlights li + li {
    margin-block-start: 0.375rem;
  }

  .stack {
    margin-block-start: 0.875rem;
  }
</style>
