---
/**
 * StackList — the technologies a project or role used.
 *
 * Renders Pills, not Tags, and the distinction is enforced by which primitive
 * is imported here rather than by remembering it at each call site. `stack` is
 * display text ("Swin Transformers"); `tags` is a slug taxonomy that filters
 * and routes. Rendering the stack as tags would invite a reader to click
 * "PyTorch" and land on a 404, so it never becomes a link.
 */
import type { HTMLAttributes } from 'astro/types';
import Pill from '../primitives/Pill.astro';

interface Props extends HTMLAttributes<'ul'> {
  items: string[];
  label?: string;
  size?: 'sm' | 'md';
  tone?: 'neutral' | 'outline';
  /** Show at most N, then "+N more" — for dense cards. */
  max?: number;
}

const {
  items,
  label = 'Technologies',
  size = 'sm',
  tone = 'outline',
  max,
  class: className,
  ...rest
} = Astro.props;

const shown = max ? items.slice(0, max) : items;
const rest_count = items.length - shown.length;
---

{
  items.length > 0 && (
    <ul class:list={['stack', className]} aria-label={label} {...rest}>
      {shown.map((item) => (
        <li>
          <Pill tone={tone} size={size}>
            {item}
          </Pill>
        </li>
      ))}
      {rest_count > 0 && (
        <li>
          {/* Announced in full, so the count is not a visual-only fact. */}
          <Pill tone="neutral" size={size} mono>
            <span aria-hidden="true">+{rest_count}</span>
            <span class="sr-only">{`and ${rest_count} more`}</span>
          </Pill>
        </li>
      )}
    </ul>
  )
}

<style>
  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
