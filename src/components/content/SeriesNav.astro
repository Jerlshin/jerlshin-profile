---
/**
 * SeriesNav — the other parts of a multi-post series.
 *
 * §4.4 models a series as `{ id, order }` on each post rather than as a
 * separate collection with a list of members. That choice is why this component
 * takes the already-filtered, already-sorted members as a prop: membership is
 * derived at build time from the posts themselves, so a post cannot be listed
 * in a series it does not belong to, and adding part 4 requires editing part 4
 * and nothing else.
 *
 * The current part is plain text with aria-current, never a link to the page
 * the reader is already on.
 */
import type { CollectionEntry } from 'astro:content';

interface Props {
  /** Every post in the series, ascending by `series.order`. */
  parts: CollectionEntry<'blog'>[];
  /** The id of the post being viewed. */
  currentId: string;
  /** Display name for the series. Falls back to the series id. */
  title?: string;
  class?: string;
}

const { parts, currentId, title, class: className } = Astro.props;

const seriesId = parts[0]?.data.series?.id;
const label = title ?? seriesId;
---

{
  parts.length > 1 && (
    <nav class:list={['series', className]} aria-labelledby="series-heading" data-pagefind-ignore>
      <p class="heading" id="series-heading">
        <span class="overline">Part of a series</span>
        {label && <span class="name">{label}</span>}
      </p>

      <ol class="list">
        {parts.map((part) => {
          const current = part.id === currentId;
          return (
            <li class:list={['part', { current }]}>
              <span class="num tabular" aria-hidden="true">
                {part.data.series?.order}
              </span>
              {current ? (
                <span aria-current="page" class="text">
                  {part.data.title}
                </span>
              ) : (
                <a href={`/blog/${part.id}`} class="text link-text">
                  {part.data.title}
                </a>
              )}
            </li>
          );
        })}
      </ol>
    </nav>
  )
}

<style>
  .series {
    margin-block: var(--space-block);
    padding: 1rem 1.125rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background-color: var(--surface-2);
  }

  .heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.625rem;
    margin-block-end: 0.75rem;
  }

  .name {
    color: var(--ink);
    font-family: var(--ff-display);
    font-size: var(--fs-base);
    font-weight: 600;
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: none;
  }

  .part {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding-block: 0.375rem;
    font-size: var(--fs-sm);
    line-height: var(--lh-normal);
  }

  .num {
    flex: none;
    inline-size: 1.5rem;
    color: var(--ink-3);
    font-family: var(--ff-mono);
    font-size: var(--fs-xs);
  }

  .text {
    color: var(--ink-2);
    text-wrap: pretty;
  }

  .link-text:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .current .text {
    color: var(--ink);
    font-weight: 600;
  }

  .current .num {
    color: var(--accent);
  }
</style>
