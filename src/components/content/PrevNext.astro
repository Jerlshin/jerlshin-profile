---
/**
 * PrevNext — chronological navigation between adjacent posts.
 *
 * "Previous" and "Next" are ambiguous words in a reverse-chronological archive:
 * next-in-the-list is older, next-in-time is newer. This component labels them
 * "Older" and "Newer", which cannot be misread, and pairs each with the post's
 * actual title so the link says where it goes.
 *
 * When only one neighbour exists the grid keeps its two columns and leaves the
 * empty side empty, so the remaining link stays on its own side of the page
 * instead of jumping to the middle on the first and last posts.
 */
import type { CollectionEntry } from 'astro:content';
import Icon from '../primitives/Icon.astro';

interface Props {
  /** The next post *in time* — newer. */
  newer?: CollectionEntry<'blog'>;
  /** The previous post *in time* — older. */
  older?: CollectionEntry<'blog'>;
  class?: string;
}

const { newer, older, class: className } = Astro.props;
---

{
  (newer || older) && (
    <nav class:list={['prevnext', className]} aria-label="More posts" data-pagefind-ignore>
      <div class="side start">
        {newer && (
          <a href={`/blog/${newer.id}`} class="entry">
            <span class="overline dir">
              <Icon name="arrow-left" size="0.8125rem" />
              Newer
            </span>
            <span class="title">{newer.data.title}</span>
          </a>
        )}
      </div>

      <div class="side end">
        {older && (
          <a href={`/blog/${older.id}`} class="entry align-end">
            <span class="overline dir">
              Older
              <Icon name="arrow-right" size="0.8125rem" />
            </span>
            <span class="title">{older.data.title}</span>
          </a>
        )}
      </div>
    </nav>
  )
}

<style>
  .prevnext {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
    margin-block-start: var(--space-block);
    padding-block-start: var(--space-block);
    border-block-start: 1px solid var(--line);
  }

  @media (min-width: 40rem) {
    .prevnext {
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }
  }

  .entry {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    block-size: 100%;
    padding: 0.875rem 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background-color: var(--surface);
    transition:
      border-color var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }

  .entry:hover {
    border-color: var(--control);
    box-shadow: var(--shadow-1);
  }

  .dir {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }

  .align-end {
    text-align: end;
  }

  .align-end .dir {
    justify-content: flex-end;
  }

  .title {
    color: var(--ink);
    font-family: var(--ff-display);
    font-size: var(--fs-base);
    line-height: var(--lh-snug);
    text-wrap: pretty;
  }

  .entry:hover .title {
    color: var(--accent);
  }
</style>
