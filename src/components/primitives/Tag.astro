---
/**
 * Tag — one taxonomy term.
 *
 * Renders the slug itself rather than a prettified label, on purpose. §4.1
 * makes tags kebab-case slugs by schema rule so that /blog/tags/[tag] URLs stay
 * stable forever and tag equality is a string compare. Showing the slug keeps
 * what you read identical to what you filter and share; inventing a display
 * name here would reintroduce exactly the two-copies-that-diverge problem from
 * audit finding #2. Pass `label` to override in the rare case it is warranted.
 *
 * `count` is baked in at build time (§6.3) — never computed in the browser.
 */
import type { HTMLAttributes } from 'astro/types';

interface Props extends Omit<HTMLAttributes<'a'>, 'href'> {
  /** The kebab-case slug. */
  name: string;
  /** Omit to render a static chip instead of a link. */
  href?: string;
  label?: string;
  /** Facet count, computed at build time. */
  count?: number;
  size?: 'sm' | 'md';
  /** Marks the currently-filtered tag. */
  current?: boolean;
}

const {
  name,
  href,
  label,
  count,
  size = 'sm',
  current = false,
  class: className,
  ...rest
} = Astro.props;

const Tag = href ? 'a' : 'span';
const text = label ?? name;
---

<Tag
  href={href}
  aria-current={href && current ? 'page' : undefined}
  class:list={['tag', `size-${size}`, { current, link: Boolean(href) }, className]}
  {...rest}
>
  <span class="name">{text}</span>
  {
    count !== undefined && (
      <span class="count tabular" aria-hidden="true">
        {count}
      </span>
    )
  }
  {count !== undefined && <span class="sr-only">{`, ${count} entries`}</span>}
</Tag>

<style>
  .tag {
    display: inline-flex;
    align-items: baseline;
    gap: 0.375rem;
    font-family: var(--ff-mono);
    font-size: var(--fs-xs);
    line-height: 1;
    color: var(--ink-2);
    background-color: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    white-space: nowrap;
  }

  .size-sm {
    padding: 0.3125rem 0.5rem;
  }

  .size-md {
    padding: 0.4375rem 0.625rem;
    font-size: var(--fs-sm);
  }

  .link {
    transition:
      color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease),
      background-color var(--dur-fast) var(--ease);
  }

  .link:hover {
    color: var(--accent);
    border-color: var(--control);
  }

  .current {
    color: var(--accent);
    background-color: var(--accent-soft);
    border-color: var(--accent);
  }

  .count {
    color: var(--ink-3);
    font-size: 0.85em;
  }

  .current .count {
    color: var(--accent);
  }
</style>
