---
/**
 * /search — the full-page search, and the ⌘K dialog's link-out.
 *
 * IT HAS A REAL NO-JAVASCRIPT ANSWER, which the dialog cannot have. Pagefind is
 * a WebAssembly client with no server behind it, so with scripting off the
 * input and the results list are inert — and §7.2 #6 asks that all content stay
 * reachable regardless. The answer is the "Browse instead" section below: it is
 * ordinary server-rendered links to every archive and every tag, present in the
 * HTML whether or not anything runs. The search panel is progressive
 * enhancement layered over a page that already works.
 *
 * `?q=` IS HONOURED, because the WebSite JSON-LD in JsonLd.astro advertises a
 * SearchAction pointing here with exactly that parameter. Advertising a query
 * string the page ignores would be a promise made to a crawler and broken —
 * the same defect class as a theme toggle that does not toggle.
 *
 * The page is `noindex`: its content is a search box, and its useful output is
 * other pages that are indexed on their own. It sets no `searchKind`, so it
 * also produces no Pagefind record — a search result pointing at the search
 * page is a small joke that stops being funny immediately.
 */
import PageLayout from '../layouts/PageLayout.astro';
import SearchResults from '../components/search/SearchResults.astro';
import Icon from '../components/primitives/Icon.astro';
import Rule from '../components/primitives/Rule.astro';
import { site } from '../config/site.ts';
import { posts } from '../lib/collections.ts';
import { facets } from '../lib/tags.ts';
import { blogTagHref } from '../lib/tags.ts';

const allPosts = await posts();
const tagFacets = facets(allPosts, blogTagHref);
---

<PageLayout
  title="Search"
  description="Search the papers, projects, and posts on this site."
  lede="Full-text search across every paper, project, and post. The index is a static file — no query leaves your browser for a server."
  eyebrow="Find"
  crumbs={[{ label: 'Search' }]}
  width="content"
  noindex
>
  <div class="panel" data-search-panel>
    <div class="field">
      <Icon name="search" size="1.125rem" class="field-icon" />
      <input
        type="search"
        class="input"
        data-search-input
        placeholder="Search papers, projects, and posts…"
        aria-label="Search query"
        autocomplete="off"
        autocorrect="off"
        spellcheck="false"
        enterkeyhint="search"
      />
    </div>

    <noscript>
      <p class="noscript">
        Search needs JavaScript, because the index is queried in your browser rather than on a
        server. Everything it would find is listed below.
      </p>
    </noscript>

    <SearchResults class="page-results" />
  </div>

  <Rule class="divider" />

  <section aria-labelledby="browse-heading" class="browse">
    <h2 id="browse-heading">Browse instead</h2>

    <ul class="links">
      {
        site.nav.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))
      }
      <li><a href="/about">About</a></li>
    </ul>

    {
      tagFacets.length > 0 && (
        <>
          <h3 class="overline tags-heading">Post tags</h3>
          <ul class="tags">
            {tagFacets.map((facet) => (
              <li>
                <a href={facet.href}>
                  {facet.tag} <span class="count">({facet.count})</span>
                </a>
              </li>
            ))}
          </ul>
        </>
      )
    }
  </section>
</PageLayout>

<script>
  import { mountSearch } from '../lib/search-ui.ts';

  const panel = document.querySelector<HTMLElement>('main [data-search-panel]');

  if (panel) {
    const search = mountSearch(panel);

    // The `?q=` contract the WebSite SearchAction advertises.
    const q = new URLSearchParams(location.search).get('q');
    if (q) search.search(q);
    else search.focus();
  }
</script>

<style>
  .panel {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .field {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.5rem 0.875rem;
    background-color: var(--surface);
    border: 1px solid var(--control);
    border-radius: var(--radius-sm);
  }

  .field:focus-within {
    border-color: var(--accent);
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  .field-icon {
    flex: none;
    color: var(--ink-3);
  }

  .input {
    flex: 1;
    min-inline-size: 0;
    padding: 0.375rem 0;
    background: transparent;
    border: 0;
    color: var(--ink);
    font-family: inherit;
    font-size: var(--fs-md);
  }

  .input:focus {
    /* The ring is on .field, so the whole control is outlined rather than the
       bare input inside it. */
    outline: none;
  }

  .input::placeholder {
    color: var(--ink-3);
  }

  .noscript {
    padding: 0.75rem 0.875rem;
    background-color: var(--warn-soft);
    border-inline-start: 2px solid var(--warn);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    color: var(--ink-2);
    font-size: var(--fs-sm);
    line-height: var(--lh-prose);
  }

  .divider {
    margin-block: var(--space-block);
  }

  .browse h2 {
    font-size: var(--fs-lg);
  }

  .links,
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
  }

  .tags {
    gap: 0.5rem;
  }

  .tags a {
    display: inline-block;
    padding: 0.1875rem 0.5rem;
    background-color: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    font-family: var(--ff-mono);
    font-size: var(--fs-xs);
  }

  .count {
    color: var(--ink-3);
  }

  .tags-heading {
    margin-block-start: var(--space-block);
  }
</style>
